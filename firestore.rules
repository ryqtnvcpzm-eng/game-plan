rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each board lives at boards/<board key>. Only someone who has the key
    // (which is in your share link, never in this repo) can open or change it.
    // Nobody can list all boards or delete one.
    match /boards/{boardId} {
      allow get, create, update: if boardId.size() >= 20;
      allow list, delete: if false;
    }
  }
}
